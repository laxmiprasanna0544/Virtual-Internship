# ---------------------------------------------------------------------------
# Runtime configuration. In AWS these come from the ECS task definition
# (plain values) and Secrets Manager (marked SECRET). Locally,
# `npm run aws:setup` writes a working .env.local for the emulators.
# ---------------------------------------------------------------------------

# Canonical site origin (build-time and runtime). Used for metadata, sitemap,
# CSRF origin checks, payment return URLs and cookie security.
NEXT_PUBLIC_SITE_URL=https://example.org

# --- Amazon RDS for PostgreSQL ----------------------------------------------
# SECRET. The application role (roystian_app), never the RDS master user.
DATABASE_URL=postgresql://roystian_app:<password>@<rds-endpoint>:5432/roystian?sslmode=verify-full
# verify-full (default) | require | disable (local only)
DATABASE_SSL=verify-full
# RDS CA bundle; the Docker image ships /etc/ssl/certs/rds-global-bundle.pem.
DATABASE_CA_PATH=/etc/ssl/certs/rds-global-bundle.pem
DATABASE_POOL_MAX=5

# --- AWS --------------------------------------------------------------------
AWS_REGION=ap-south-1
# No access keys in AWS: the ECS task role provides credentials.

# --- Amazon Cognito ----------------------------------------------------------
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=
# SECRET.
COGNITO_CLIENT_SECRET=
# Staff accounts must enrol an authenticator app (TOTP). Keep true in production.
STAFF_MFA_REQUIRED=true

# --- Amazon S3 (practical task and project uploads) ---------------------------
S3_UPLOADS_BUCKET=roystian-prod-submissions-<account-id>

# --- Amazon SES (transactional email) -----------------------------------------
SES_FROM=Roystian Foundation <no-reply@example.org>
SES_CONFIGURATION_SET=roystian-prod

# --- Cashfree Payments ---------------------------------------------------------
# production | sandbox   ("mock" is for local development and tests only)
CASHFREE_ENV=production
CASHFREE_APP_ID=
# SECRET. Also verifies webhook signatures.
CASHFREE_SECRET_KEY=

# --- Local emulators only (leave unset in AWS) ---------------------------------
# COGNITO_ENDPOINT=http://localhost:5055
# COGNITO_JWKS_URL=http://localhost:5055/<pool-id>/.well-known/jwks.json
# S3_ENDPOINT=http://localhost:5055
# S3_PUBLIC_ENDPOINT=http://localhost:5055
# SES_ENDPOINT=http://localhost:5055
# CASHFREE_API_BASE=http://localhost:8787/pg
# COOKIE_SECURE=false
