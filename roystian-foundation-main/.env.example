# Supabase — project URL and anon (publishable) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. Server only — bypasses row level security.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# "simulated" enables the demo checkout. Leave unset in production: enrolment
# is then refused until the Cashfree webhook is in place.
PAYMENT_MODE=

# Cashfree payment gateway (server only).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Canonical site origin for sitemap, robots and OG metadata.
NEXT_PUBLIC_SITE_URL=
