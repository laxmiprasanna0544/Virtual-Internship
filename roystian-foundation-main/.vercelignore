# Files that must never be uploaded to a Vercel deployment.
#
# The Vercel CLI uploads the working directory, including untracked files,
# and when this file exists it does NOT read .gitignore — so secrets and local
# state must be excluded here explicitly.

# Secrets and local environment
.env
.env.*
!.env.example
.local/
.vercel/

# Local tooling, test harnesses and evidence (not needed to build or run)
.selftest/
scripts/
docs/
infra/
test-evidence/
*.tsbuildinfo

# Source material and working documents kept in the project root. The
# learning guides the app serves live in content/guides/ and ARE deployed.
temp_pdfs/
logo.jpeg
about-us/
*.pdf
!content/guides/*.pdf

# Original explainer video (web encodes live in public/videos/)
/Video.mp4
