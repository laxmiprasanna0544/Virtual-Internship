# Copy to terraform.tfvars (git-ignored) and fill in.
domain_name       = "example.org"
alert_email       = "ops@example.org"
github_repository = "laxmiprasanna0544/Virtual-Internship"

# Production defaults; lower for a staging copy.
db_multi_az        = true
single_nat_gateway = true
app_min_tasks      = 2
app_max_tasks      = 6
cashfree_env       = "production"

# Leave false until the go-live checklist passes on the CloudFront domain.
create_public_dns = false

# Set false if your AWS Organization already provides these.
enable_guardduty  = true
enable_cloudtrail = true
