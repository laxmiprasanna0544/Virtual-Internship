{
  "name": "roystian-foundation",
  "version": "1.0.0",
  "private": true,
  "description": "Roystian Foundation — Virtual Internship & Skill Development Platform",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "start:standalone": "node scripts/start-standalone.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "tsc -p tsconfig.selftest.json && node -r ./.selftest-register.cjs .selftest/scripts/selftest.js",
    "local:up": "docker compose up -d",
    "local:down": "docker compose down -v",
    "local:setup": "node scripts/local-setup.mjs",
    "db:migrate": "dbmate --env-file .env.local --migrations-dir db/migrations --no-dump-schema up",
    "db:new": "dbmate --migrations-dir db/migrations new",
    "db:types": "node scripts/gen-db-types.mjs",
    "test:rls": "node scripts/tests/rls.test.mjs",
    "test:auth": "node scripts/tests/auth.test.mjs",
    "test:journey": "node scripts/tests/journey.test.mjs",
    "test:payments": "node scripts/tests/payments.test.mjs",
    "test:admin": "node scripts/tests/admin.test.mjs",
    "test:career": "node scripts/tests/career.test.mjs",
    "test:security": "node scripts/tests/security.test.mjs",
    "test:e2e": "node scripts/tests/browser.e2e.mjs",
    "test:all": "node scripts/tests/run-all.mjs",
    "test:crypto": "node scripts/tests/crypto.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-presigned-post": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.27",
    "next-themes": "^0.4.4",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "sonner": "^1.7.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.12",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dbmate": "^2.36.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "postcss": "$postcss"
  },
  "engines": {
    "node": ">=20.11"
  }
}
